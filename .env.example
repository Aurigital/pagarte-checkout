# ===========================================
# PagArte (Artemis Money) — cobros en cripto
# Panel: Ventas Online -> Sandbox -> Configuracion
# Docs:  https://pagarte.artemis.money/docs/es
# ===========================================

PAGARTE_API_URL=https://api.artemis.money
NEXT_PUBLIC_PAGARTE_CHECKOUT_ORIGIN=https://checkout.pagarte.artemis.money

# Llave secreta: SOLO servidor. El panel la muestra una sola vez.
# Sandbox: pgart_test_...   Live: pgart_live_...
PAGARTE_SECRET_KEY=pgart_test_xxx

# ID del widget. OJO: sandbox y Live tienen widgets DISTINTOS.
PAGARTE_WIDGET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Origen que embebe el checkout. Debe coincidir EXACTO con un
# "Sitio autorizado" del panel. En produccion: https://pagarte.aurigital.com
STORE_ORIGIN=http://localhost:3000

# -----------------------------------------
# App
# -----------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000
AUTH_PASSWORD=cambiar_en_produccion
